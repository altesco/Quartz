<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quartz.UI.App"
             xmlns:themes="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:local="clr-namespace:Quartz.UI.Behaviors"
             xmlns:converters="using:Avalonia.Controls.Converters"
             xmlns:cc="using:AvaloniaEdit.CodeCompletion"
             xmlns:comp="using:Quartz.UI.CodeCompletion"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <converters:PlatformKeyGestureConverter x:Key="KeyGestureConverter" />
            <x:Double x:Key="TreeViewItemIndent">24</x:Double>
            <x:Double x:Key="TreeViewItemExpandCollapseChevronSize">16</x:Double>
            <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">0</Thickness>
            <CornerRadius x:Key="SmCornerRadius">4</CornerRadius>

            <!-- ДАЕМ УНИКАЛЬНЫЙ КЛЮЧ: QuartzTreeViewItemTheme -->
            <ControlTheme x:Key="QuartzTreeViewItemTheme" TargetType="TreeViewItem">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <StackPanel>
                            <Border Name="PART_LayoutRoot"
                                    Classes="TreeViewItemLayoutRoot"
                                    Focusable="True"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,1"
                                    VerticalAlignment="Center"
                                    ClipToBounds="False"
                                    TemplatedControl.IsTemplateFocusTarget="True">
                                <Panel ClipToBounds="False">
                                    <local:TreeIndentGuide />
                                    <Grid Name="PART_Header"
                                          ColumnDefinitions="Auto, *"
                                          MinHeight="24"
                                          VerticalAlignment="Center">
                                        <Grid.Margin>
                                            <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                                <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <DynamicResource ResourceKey="TreeViewItemIndent" />
                                            </MultiBinding>
                                        </Grid.Margin>
                                        <Panel Name="PART_ExpandCollapseChevronContainer"
                                               Margin="0"
                                               Width="18"
                                               Height="24"
                                               VerticalAlignment="Center">
                                            <ToggleButton Name="PART_ExpandCollapseChevron"
                                                          Width="16"
                                                          Height="16"
                                                          MinWidth="0"
                                                          MinHeight="0"
                                                          Margin="0"
                                                          Padding="0"
                                                          Cursor="Hand"
                                                          Focusable="False"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"
                                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Panel Background="Transparent" x:CompileBindings="False">
                                                            <LucideIcon HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Kind="ChevronRight"
                                                                        Size="16"
                                                                        Foreground="{DynamicResource MutedColor}"
                                                                        IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                                                            <LucideIcon HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Kind="ChevronDown"
                                                                        Size="16"
                                                                        Foreground="{DynamicResource MutedColor}"
                                                                        IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                                                        </Panel>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Panel>
                                        <ContentPresenter Name="PART_HeaderPresenter"
                                                          Grid.Column="1"
                                                          Focusable="False"
                                                          Background="Transparent"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,0,0" />
                                    </Grid>
                                </Panel>
                            </Border>
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            IsVisible="{TemplateBinding IsExpanded}"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter>

                <!-- Наведение курсора -->
                <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
                    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                </Style>

                <!-- Выделенный элемент -->
                <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
                </Style>

                <Style Selector="^:selected /template/ Border#PART_LayoutRoot:pointerover">
                    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                </Style>

                <!-- Пустой узел (файл): скрываем стрелку, оставляем контейнер 18px для выравнивания -->
                <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
                    <Setter Property="Width" Value="18" />
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem" BasedOn="{StaticResource QuartzTreeViewItemTheme}" />

            <ControlTheme TargetType="MenuItem" x:Key="ShadMenuItemTheme">
                <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="shadui:MenuItemAssist.Label" Value="{x:Null}" />
                <Setter Property="Transitions">
                    <Setter.Value>
                        <Transitions>
                            <BrushTransition Duration="0:0:0.20" Easing="{DynamicResource EaseOut}" Property="Background" />
                        </Transitions>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Name="BaseBackground"
                                Opacity="1">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Duration="0:0:0.20" Easing="{DynamicResource EaseOut}" Property="Opacity" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border
                                Background="{DynamicResource GhostColor}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Name="HoverBackground"
                                Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Duration="0:0:0.20" Easing="{DynamicResource EaseOut}" Property="Opacity" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Panel>
                                <Border
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Name="BorderContainer">
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="A" Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Content="{TemplateBinding Icon}"
                                            Height="8"
                                            HorizontalAlignment="Center"
                                            IsVisible="{TemplateBinding Icon,
                                                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Margin="0,0,8,0"
                                            Name="Icon"
                                            VerticalAlignment="Center" />
                                        <ContentPresenter
                                            Content="{TemplateBinding Header}"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            Name="HeaderPresenter"
                                            VerticalAlignment="Center">
                                            <ContentPresenter.DataTemplates>
                                                <DataTemplate DataType="system:String">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Normal"
                                                        Text="{CompiledBinding}" />
                                                </DataTemplate>
                                            </ContentPresenter.DataTemplates>
                                        </ContentPresenter>
                                        <PathIcon
                                            Data="{x:Static shadui:Icons.ChevronRight}"
                                            DockPanel.Dock="Right"
                                            Foreground="{DynamicResource ForegroundColor}"
                                            Grid.Column="2"
                                            Height="10"
                                            HorizontalAlignment="Right"
                                            Margin="16,0,0,0"
                                            Name="RightArrow"
                                            VerticalAlignment="Center"
                                            Width="10" />
                                        <TextBlock
                                            FontSize="12"
                                            Grid.Column="3"
                                            IsVisible="{TemplateBinding InputGesture,
                                                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Margin="8,0,0,0"
                                            Name="InputGestureText"
                                            Opacity="0.5"
                                            Text="{TemplateBinding InputGesture,
                                                                   Converter={StaticResource KeyGestureConverter}}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Popup
                                    IsLightDismissEnabled="False"
                                    IsOpen="{TemplateBinding IsSubMenuOpen,
                                                             Mode=TwoWay}"
                                    Name="PART_Popup"
                                    Opacity="0"
                                    OverlayInputPassThroughElement="{Binding RelativeSource={RelativeSource AncestorType=Control}}"
                                    Placement="RightEdgeAlignedTop">
                                    <LayoutTransformControl Name="LayoutTransform" RenderTransformOrigin="0%, 0%">
                                        <Border
                                            Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            BoxShadow="{DynamicResource Shadow}"
                                            CornerRadius="{DynamicResource LgCornerRadius}"
                                            Margin="0,0,2,4">
                                            <StackPanel Margin="0,2">
                                                <Border IsVisible="{TemplateBinding shadui:MenuItemAssist.Label, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="16,8">
                                                    <ContentPresenter Content="{TemplateBinding shadui:MenuItemAssist.Label}" />
                                                </Border>
                                                <ScrollViewer ClipToBounds="True">
                                                    <ItemsPresenter
                                                        Grid.IsSharedSizeScope="True"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        Name="ItemsPresenter" />
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </LayoutTransformControl>
                                </Popup>
                            </Panel>
                        </Panel>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.50" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
                <Style Selector="^:not(.Menu):disabled">
                    <Setter Property="Opacity" Value="0.56" />
                </Style>
                <Style Selector="^:empty /template/ PathIcon#RightArrow">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^[FlowDirection=RightToLeft] /template/ Popup#Popup">
                    <Setter Property="HorizontalOffset" Value="25" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#HoverBackground">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#BaseBackground">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^:open /template/ Border#HoverBackground">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="^:open /template/ Border#BaseBackground">
                    <Setter Property="Opacity" Value="0" />
                </Style>

                <Style Selector="^:open /template/ LayoutTransformControl#LayoutTransform">
                    <Style.Animations>
                        <Animation
                            Duration="0:0:0.18"
                            Easing="{DynamicResource EaseOut}"
                            FillMode="Forward">
                            <KeyFrame Cue="0%">
                                <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                                <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                                <Setter Property="Opacity" Value="0" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                <Setter Property="ScaleTransform.ScaleX" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>

                <Style Selector="^.Destructive">
                    <Setter Property="Foreground" Value="{DynamicResource DestructiveColor}" />
                    <Style Selector="^ /template/ Border#HoverBackground">
                        <Setter Property="Background" Value="{DynamicResource DestructiveColor10}" />
                    </Style>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem" BasedOn="{StaticResource ShadMenuItemTheme}" />
            <ControlTheme x:Key="ShadFlyoutPresenterTheme" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}" />

            <!-- ДАЕМ УНИКАЛЬНЫЙ КЛЮЧ: QuartzFlyoutTheme -->
            <ControlTheme x:Key="QuartzFlyoutTheme" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

                <Setter Property="TextBlock.FontSize" Value="14" />
                <Setter Property="TextBlock.FontWeight" Value="Normal" />

                <!-- компенсация теней -->
                <Setter Property="local:FlyoutAssist.HorizontalOffset" Value="-12" />
                <Setter Property="local:FlyoutAssist.VerticalOffset" Value="-12" />

                <Setter Property="Template">
                    <ControlTemplate>
                        <!-- Отступ 12 во все стороны для красивой тени -->
                        <Border Name="LayoutRoot"
                                Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor60}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SmCornerRadius}"
                                Margin="12"
                                BoxShadow="0 6 12 0 #40000000">

                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseIn" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseIn" />
                                </Transitions>
                            </Border.Transitions>

                            <Border.Styles>
                                <Style Selector="Border#LayoutRoot">
                                    <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                                <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>

                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                KeyboardNavigation.TabNavigation="Continue"
                                                Grid.IsSharedSizeScope="True"
                                                Margin="{TemplateBinding Padding}" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ДАЕМ УНИКАЛЬНЫЙ КЛЮЧ: QuartzToolTipTheme -->
            <ControlTheme x:Key="QuartzToolTipTheme" TargetType="ToolTip">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="IsHitTestVisible" Value="False" />

                <!-- компенсация теней настраивается через FlyoutAssist с учетом Placement -->
                <Setter Property="local:FlyoutAssist.VerticalOffset" Value="-12" />

                <Setter Property="Template">
                    <ControlTemplate TargetType="ToolTip">
                        <Panel Background="Transparent" IsHitTestVisible="False">
                            <!-- Отступ 12 во все стороны для красивой тени -->
                            <Border Name="LayoutRoot"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource CardBackgroundColor}"
                                    BorderBrush="{DynamicResource BorderColor60}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource SmCornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="12"
                                    BoxShadow="0 6 12 0 #40000000">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Panel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ТЕМА ДЛЯ ЭЛЕМЕНТОВ СПИСКА АВТОДОПОЛНЕНИЯ (ListBoxItem) -->
            <ControlTheme x:Key="QuartzCompletionListBoxItemTheme" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="PART_LayoutRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                </Style>

                <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource GhostColor}" />
                </Style>

                <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                </Style>
            </ControlTheme>

            <!-- ТЕМА ДЛЯ CompletionListBox -->
            <ControlTheme x:Key="{x:Type cc:CompletionListBox}" TargetType="cc:CompletionListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemContainerTheme" Value="{StaticResource QuartzCompletionListBoxItemTheme}" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="cc:CompletionListBox">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                            Margin="{TemplateBinding Padding}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ТЕМА ДЛЯ ВСИТЫВАЮЩЕГО ОКНА CompletionList (в точности как QuartzFlyoutTheme) -->
            <ControlTheme x:Key="{x:Type cc:CompletionList}" TargetType="cc:CompletionList">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="FontFamily" Value="JetBrains Mono, Consolas, Courier New, Monospace" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="cc:CompletionList">
                        <!-- Отступ 12 во все стороны для мягкой тени без обрезания в PopupRoot -->
                        <Border Name="LayoutRoot"
                                Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor60}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SmCornerRadius}"
                                Margin="12"
                                BoxShadow="0 6 12 0 #40000000">

                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseIn" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseIn" />
                                </Transitions>
                            </Border.Transitions>

                            <Border.Styles>
                                <Style Selector="Border#LayoutRoot">
                                    <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                                                <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                                <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>

                            <Panel>
                                <cc:CompletionListBox Name="PART_ListBox"
                                                      Margin="{TemplateBinding Padding}"
                                                      FontFamily="{TemplateBinding FontFamily}"
                                                      MaxHeight="260"
                                                      MinWidth="190">
                                    <cc:CompletionListBox.ItemTemplate>
                                        <DataTemplate DataType="comp:QuartzCompletionData">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                <LucideIcon Kind="{Binding IconKind}"
                                                            Size="14"
                                                            StrokeWidth="1.75"
                                                            Foreground="{DynamicResource ForegroundLeadColor}"
                                                            VerticalAlignment="Center"
                                                            Margin="2,0,8,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontFamily="{Binding $parent[cc:CompletionList].FontFamily}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ForegroundColor}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Detail}"
                                                           FontFamily="{Binding $parent[cc:CompletionList].FontFamily}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedColor}"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,4,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </cc:CompletionListBox.ItemTemplate>
                                </cc:CompletionListBox>

                                <TextBlock Name="PART_EmptyText"
                                           Text="Предложения отсутствуют"
                                           FontSize="13"
                                           Margin="8,4,8,4"
                                           Foreground="{DynamicResource MutedColor}"
                                           FontFamily="{x:Static FontFamily.Default}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                            </Panel>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^ /template/ TextBlock#PART_EmptyText">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <Style Selector="^.empty /template/ cc|CompletionListBox#PART_ListBox">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <Style Selector="^.empty /template/ TextBlock#PART_EmptyText">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Quartz.UI/Views/Themes/Catppuccin.axaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <themes:ShadTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- 1. ПРИБИВАЕМ ТЕМУ ГВОЗДЯМИ ДЛЯ ВСЕХ МЕНЮ, ЧТОБЫ SHADUI НЕ СМЕЛ ЕЕ СБИВАТЬ -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Theme" Value="{DynamicResource QuartzFlyoutTheme}" />
        </Style>

        <!-- 2. Это тоже оставляем, чтобы внутренние пункты использовали стили ShadUI -->
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="Theme" Value="{DynamicResource ShadMenuItemTheme}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Стилизация окна автодополнения кода AvaloniaEdit -->
        <Style Selector="cc|CompletionList">
            <Setter Property="Theme" Value="{DynamicResource {x:Type cc:CompletionList}}" />
        </Style>
        <Style Selector="cc|CompletionListBox">
            <Setter Property="Theme" Value="{DynamicResource {x:Type cc:CompletionListBox}}" />
        </Style>

        <Style Selector="Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
        </Style>

        <Style Selector="PopupRoot">
            <Setter Property="TransparencyLevelHint" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 3. Прибиваем тему гвоздями для всех ToolTip -->
        <Style Selector="ToolTip">
            <Setter Property="Theme" Value="{DynamicResource QuartzToolTipTheme}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- 4. Стилизация всплывающего меню SimpleDropdown как у контекстного меню (QuartzFlyoutTheme) -->
        <Style Selector="shadui|SimpleDropdown">
            <Setter Property="local:FlyoutAssist.HorizontalOffset" Value="-12" />
            <Setter Property="local:FlyoutAssist.VerticalOffset" Value="-12" />
            <Setter Property="PopupHorizontalOffset" Value="-12" />
            <Setter Property="PopupVerticalOffset" Value="-12" />
        </Style>

        <Style Selector="shadui|SimpleDropdown /template/ Popup#PART_Popup Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 12 0 #40000000" />
            <Setter Property="Padding" Value="4, 3" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseIn" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseIn" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="shadui|SimpleDropdown /template/ Popup#PART_Popup StackPanel">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="shadui|SimpleDropdown /template/ Popup#PART_Popup ScrollViewer">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="shadui|SimpleDropdown /template/ Popup#PART_Popup LayoutTransformControl">
            <Setter Property="Margin" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Style.Animations>
                <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderColor60}" />
        </Style>


        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,0,10,1" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Заставляем текст пункта меню выравниваться по центру и сбрасываем FontWeight в Normal -->
        <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="MenuItem /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="MenuItem /template/ ContentPresenter#Header">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="MenuItem /template/ TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="MenuItem TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Сбрасываем кривую высоту иконок в меню от ShadUI (NaN = Auto) -->
        <Style Selector="MenuItem /template/ ContentPresenter#Icon">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="20" />
        </Style>

        <!-- На всякий случай выравниваем саму иконку, если LucideIconContent чудит -->
        <Style Selector="MenuItem /template/ ContentPresenter#Icon > LucideIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        
        <Style Selector="Button.Icon">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TreeView">
            <Setter Property="ItemContainerTheme" Value="{StaticResource QuartzTreeViewItemTheme}" />
            <Setter Property="SelectionMode" Value="Multiple" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor30}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="TreeViewItem">
            <Setter Property="Theme" Value="{StaticResource QuartzTreeViewItemTheme}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SmCornerRadius}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>

        <Style Selector="shadui|SimpleDropdown TreeViewItem">
            <Setter Property="Theme" Value="{StaticResource QuartzTreeViewItemTheme}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style Selector="Popup TreeViewItem">
            <Setter Property="Theme" Value="{StaticResource QuartzTreeViewItemTheme}" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="local:TreeIndentGuideAssist.ShowGuides" Value="True" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- Наведение курсора (проверяем наведение именно на строку LayoutRoot, а не на весь TreeViewItem) -->
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        </Style>

        <!-- Выбранный элемент (:selected) оставляем как есть, так как выделение не наследуется -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>

        <!-- Выбранный элемент при наведении -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
        </Style>

        <!-- Шаблон стрелочки: видимость иконок управляется напрямую через IsChecked кнопки -->
        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Panel Background="Transparent" x:CompileBindings="False">

                        <!-- Закрыто: видно, пока IsChecked = False (!IsChecked) -->
                        <LucideIcon HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="ChevronRight"
                                    Size="16"
                                    Foreground="{DynamicResource MutedColor}"
                                    IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- Открыто: видно, когда IsChecked = True -->
                        <LucideIcon HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="ChevronDown"
                                    Size="16"
                                    Foreground="{DynamicResource MutedColor}"
                                    IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />

                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="FontWeight" Value="{Binding $parent[Button].FontWeight}" />
        </Style>

        <Style Selector="Button :is(TextBlock)">
            <Setter Property="FontWeight" Value="{Binding $parent[Button].FontWeight}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        </Style>

        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="shadui|SimpleDropdown /template/ ContentPresenter">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="shadui|SimpleDropdown, shadui|SimpleDropdown.Ghost, shadui|SimpleDropdown.Primary, shadui|SimpleDropdown.Secondary, shadui|SimpleDropdown.Outline">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{Binding $parent[TemplatedControl].FontSize}" />
        </Style>

        <Style Selector="ItemsControl shadui|SimpleDropdown, ItemsControl shadui|SimpleDropdown.Ghost">
            <Setter Property="FontSize" Value="{Binding $parent[ItemsControl].FontSize}" />
        </Style>

        <Style Selector="shadui|SimpleDropdown.Ghost /template/ Border#HoverBackground">
            <Setter Property="Background" Value="{DynamicResource GhostColor}" />
        </Style>
    </Application.Styles>
</Application>