<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="GridSplitter.overlay-splitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition
                    Easing="QuadraticEaseOut"
                    Property="Background"
                    Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="GridSplitter.overlay-splitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style Selector="GridSplitter.overlay-splitter:pointerover, GridSplitter.overlay-splitter.dragging">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
    </Style>

</Styles>