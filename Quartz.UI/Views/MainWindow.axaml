<Window
    x:Class="Quartz.UI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="using:AvaloniaEdit"
    xmlns:controls="using:Quartz.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:enums="using:Quartz.UI.Enums"
    xmlns:tools="using:Quartz.UI.Tools"
    xmlns:vm="using:Quartz.UI.ViewModels"
    xmlns:beh="using:Quartz.UI.Behaviors"
    xmlns:models="using:Quartz.Core.Models"
    xmlns:shadui="using:ShadUI"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:themes="clr-namespace:ShadUI;assembly=ShadUI"
    Title="Quartz.UI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainVM"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Window.Background>
        <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}" />
    </Window.Background>

    <Window.Styles>
        <StyleInclude Source="avares://Quartz.UI/Views/Resources/MainTemplates.axaml" />
    </Window.Styles>

    <Design.DataContext>
        <vm:MainVM />
    </Design.DataContext>

    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="PointerMoved">
            <InvokeCommandAction Command="{Binding MoveFileCommand}" PassEventArgsToCommand="True" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="PointerReleased">
            <InvokeCommandAction Command="{Binding ResetDragStatusCommand}" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="PointerCaptureLost">
            <InvokeCommandAction Command="{Binding ResetDragStatusCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Window.DataTemplates>
        <TreeDataTemplate DataType="vm:SplitContainerVM" ItemsSource="{Binding Children}">
            <tools:LayoutGrid Source="{Binding}" />
        </TreeDataTemplate>

        <DataTemplate DataType="vm:PanelVM">
            <Border Width="{Binding PanelWidth, Mode=OneWayToSource}"
                    Height="{Binding PanelHeight, Mode=OneWayToSource}">
                <TabControl
                    Padding="0"
                    BorderBrush="{DynamicResource BorderColor60}"
                    BorderThickness="0,1,1,0"
                    ItemsSource="{Binding Tabs}"
                    Background="{DynamicResource TitleBarBackgroundColor}"
                    SelectedItem="{Binding SelectedTab}">
                    <TabControl.Resources>
                        <ResourceDictionary>
                            <themes:ShadTheme x:Key="ShadThemeLocal" />
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="avares://Quartz.UI/Views/Themes/Catppuccin.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </TabControl.Resources>
                    <TabControl.Styles>
                        <FluentTheme />
                        <Style Selector="TabItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundColor}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor30}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Padding" Value="4,0,4,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ClipToBounds" Value="False" />
                            <Setter Property="ZIndex" Value="1" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border
                                        Height="{TemplateBinding Height}"
                                        HorizontalAlignment="Stretch"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="PointerPressed">
                                                <InvokeCommandAction
                                                    Command="{Binding $parent[TabControl].((vm:PanelVM)DataContext).TabReplaceCommand}"
                                                    PassEventArgsToCommand="True" />
                                            </EventTriggerBehavior>
                                            <EventTriggerBehavior EventName="PointerMoved">
                                                <InvokeCommandAction
                                                    Command="{Binding $parent[TabControl].((vm:PanelVM)DataContext).SelectSideCommand}"
                                                    PassEventArgsToCommand="True" />
                                            </EventTriggerBehavior>
                                            <EventTriggerBehavior EventName="PointerReleased">
                                                <InvokeCommandAction
                                                    Command="{Binding $parent[TabControl].((vm:PanelVM)DataContext).TabReplacedCommand}"
                                                    PassEventArgsToCommand="True" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                        <Grid>
                                            <ContentPresenter
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding Header}"
                                                ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                            <Border
                                                x:Name="PART_RightLine"
                                                Width="3"
                                                Margin="1,-1,-1,0"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource SystemAccentColor}"
                                                IsVisible="{Binding $parent[TabItem].((vm:FileVM)DataContext).InsertSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Right}}" />
                                            <Border
                                                x:Name="PART_LeftLine"
                                                Width="3"
                                                Margin="-3,-1,3,0"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource SystemAccentColor}"
                                                IsVisible="{Binding $parent[TabItem].((vm:FileVM)DataContext).InsertSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Left}}" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        
                            <Setter Property="ContextFlyout" x:DataType="vm:File2D">
                                <Setter.Value>
                                    <MenuFlyout FlyoutPresenterTheme="{StaticResource ShadFlyoutPresenterTheme}">

                                        <!-- Контент твоего меню -->
                                        <MenuItem Header="Открыть холст" Command="{Binding OpenCanvasCommand}" />
                                    </MenuFlyout>
                                </Setter.Value>
                            </Setter>

                            <!-- Наведение курсора (:pointerover) -->
                            <Style Selector="^:pointerover">
                                <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                            </Style>

                            <!-- Выбранный элемент (:selected) -->
                            <Style Selector="^:selected">
                                <Setter Property="Background" Value="{DynamicResource GhostColor}" />
                                <Setter Property="ZIndex" Value="100" />
                            </Style>

                            <!-- Выбранный элемент при наведении (:selected:pointerover) -->
                            <Style Selector="^:selected:pointerover">
                                <Setter Property="Background" Value="{DynamicResource GhostHoverColor}" />
                                <Setter Property="ZIndex" Value="100" />
                            </Style>

                        </Style>

                        <Style Selector="TabItem Button.icon-button">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>

                        <Style Selector="TabItem:selected Button.icon-button">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </Style>

                        <Style Selector="TabItem:pointerover Button.icon-button">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </Style>

                        <Style Selector="TabItem.last-child /template/ Border#PART_RightLine">
                            <Setter Property="Margin" Value="1,-1,-1,0" />
                        </Style>

                        <Style Selector="TabItem.first-child /template/ Border#PART_LeftLine">
                            <Setter Property="Margin" Value="0,-1,0,0" />
                        </Style>

                        <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor30}" />
                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                        </Style>

                        <Style Selector="TabControl[TabStripPlacement=Top] /template/ ItemsPresenter#PART_ItemsPresenter">
                            <Setter Property="Margin" Value="0,0,-1,-1" />
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="ZIndex" Value="100" />
                            <Setter Property="Grid.RowSpan" Value="3" />
                        </Style>

                        <Style Selector="ae|TextEditor Line">
                            <Setter Property="Opacity" Value="0" />
                        </Style>

                    </TabControl.Styles>

                    <Interaction.Behaviors>
                        <RoutedEventTriggerBehavior
                            RoutedEvent="{x:Static InputElement.PointerPressedEvent}"
                            RoutingStrategies="Tunnel">
                            <InvokeCommandAction Command="{Binding SelectPanelCommand}" />
                        </RoutedEventTriggerBehavior>
                    </Interaction.Behaviors>

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    MinWidth="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Header}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Classes="icon-button"
                                    Command="{Binding RemoveTabCommand}"
                                    Foreground="White">
                                    <LucideIcon Kind="X" Size="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="PointerReleased">
                                        <InvokeCommandAction
                                            Command="{Binding $parent[TabControl].((vm:PanelVM)DataContext).TabReplacedCommand}" />
                                    </EventTriggerBehavior>
                                    <EventTriggerBehavior EventName="PointerExited">
                                        <InvokeCommandAction
                                            Command="{Binding $parent[TabControl].((vm:PanelVM)DataContext).ResetSideCommand}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                                <ContentControl Content="{Binding}" />

                                <Border
                                    Width="80"
                                    HorizontalAlignment="Right"
                                    Background="Blue"
                                    IsVisible="{Binding $parent[TabControl].((vm:PanelVM)DataContext).NewNodeSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Right}}" />
                                <Border
                                    Width="80"
                                    HorizontalAlignment="Left"
                                    Background="Blue"
                                    IsVisible="{Binding $parent[TabControl].((vm:PanelVM)DataContext).NewNodeSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Left}}" />
                                <Border
                                    Height="80"
                                    VerticalAlignment="Top"
                                    Background="Blue"
                                    IsVisible="{Binding $parent[TabControl].((vm:PanelVM)DataContext).NewNodeSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Top}}" />
                                <Border
                                    Height="80"
                                    VerticalAlignment="Bottom"
                                    Background="Blue"
                                    IsVisible="{Binding $parent[TabControl].((vm:PanelVM)DataContext).NewNodeSide, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:Side.Bottom}}" />
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>

                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:FillLastInRowPanel />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                </TabControl>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:EditorVM">
            <Grid RowDefinitions="Auto,*" Background="{DynamicResource WindowBackgroundColor}" >

                <Grid.Styles>
                    <themes:ShadTheme/>
                </Grid.Styles>

                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceInclude Source="avares://Quartz.UI/Views/Themes/Catppuccin.axaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>

                <ae:TextEditor
                    x:Name="Editor"
                    Grid.Row="1"
                    tools:Marker.Errors="{Binding Errors}"
                    tools:ScrollProps.HorizontalOffset="{Binding ScrollX}"
                    tools:ScrollProps.VerticalOffset="{Binding ScrollY}"
                    Document="{Binding Document, Mode=TwoWay}"
                    FontFamily="JetBrains Mono, Consolas, Courier New, Monospace"
                    FontSize="{Binding FontSize, Mode=TwoWay}"
                    HorizontalScrollBarVisibility="Auto"
                    ShowLineNumbers="True"
                    VerticalScrollBarVisibility="Visible"
                    WordWrap="False"
                    LineNumbersMargin="0,0,16,0"
                    Margin="16,0,0,0">
                    <ae:TextEditor.Options>
                        <ae:TextEditorOptions
                            ConvertTabsToSpaces="True"
                            IndentationSize="2" 
                            HighlightCurrentLine="True"/>
                    </ae:TextEditor.Options>
                    <Interaction.Behaviors>
                        <beh:TextEditorBehavior/>
                    </Interaction.Behaviors>
                </ae:TextEditor>

                <Border Grid.Row="0" BoxShadow="0 2 5 2 #40000000">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasTitleBarShadow" />
                            <Binding 
                                Path="ActualThemeVariant" 
                                RelativeSource="{RelativeSource AncestorType=Window}"
                                Converter="{x:Static ObjectConverters.Equal}"
                                ConverterParameter="{x:Static ThemeVariant.Dark}" />
                        </MultiBinding>
                    </Border.IsVisible>
                </Border>

                <Border Grid.Row="0" BoxShadow="0 2 5 2 #20000000">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasTitleBarShadow" />
                            <Binding
                                Path="ActualThemeVariant"
                                RelativeSource="{RelativeSource AncestorType=Window}"
                                Converter="{x:Static ObjectConverters.Equal}"
                                ConverterParameter="{x:Static ThemeVariant.Light}" />
                        </MultiBinding>
                    </Border.IsVisible>
                </Border>

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto" 
                    Margin="8,4">
                    <StackPanel
                        Orientation="Horizontal">
                        <Button
                            Classes="Icon"
                            Content="{LucideIconContent ArrowLeft, Size=18}"/>
                        <Button
                            Classes="Icon"
                            Content="{LucideIconContent ArrowRight, Size=18}"/>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Text="some / folder / example.pcby"
                        FontSize="14"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        Classes="Icon"
                        Content="{LucideIconContent EllipsisVertical, Size=18}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Редактировать" >
                                </MenuItem>

                                <MenuItem Header="Дублировать"/>

                                <!-- Разделитель -->
                                <Separator/>

                                <MenuItem Header="Удалить"  Foreground="Red"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:CanvasVM">
            <Grid>
                <controls:CircuitBoardCanvas
                    DrawingData="{Binding RenderData}"
                    Zoom="{Binding Zoom, Mode=TwoWay}"
                    OffsetX="{Binding OffsetX, Mode=TwoWay}"
                    OffsetY="{Binding OffsetY, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="*,Auto">
        
        <Border BorderBrush="{DynamicResource BorderColor30}" BorderThickness="0,0,1,0" Grid.RowSpan="2" Background="{DynamicResource TitleBarBackgroundColor}">
            <StackPanel Margin="6,3" Spacing="3">
                <Button Classes="Icon" Content="{LucideIconContent FolderClosed, Size=20}" />
                <Button Classes="Icon" Content="{LucideIconContent Search, Size=20}" />
                <Button Classes="Icon" Content="{LucideIconContent Route, Size=20}" />
            </StackPanel>
        </Border>
        
        <TreeView 
            ItemsSource="{Binding FileTree}" 
            Grid.Column="1"
            Grid.RowSpan="2"
            Background="{DynamicResource SidebarBackgroundColor}"
            BorderThickness="0,0,1,0">
            <TreeView.Styles>
                <FluentTheme/>
                <Style Selector="TreeViewItem">
                    <Setter Property="Interaction.Behaviors">
                        <BehaviorCollectionTemplate>
                            <BehaviorCollection>
                                <RoutedEventTriggerBehavior RoutedEvent="{x:Static InputElement.PointerPressedEvent}"
                                                            RoutingStrategies="Tunnel">
                                    <InvokeCommandAction Command="{Binding FileReplaceCommand}"
                                                         PassEventArgsToCommand="True" />
                                </RoutedEventTriggerBehavior>
                                <RoutedEventTriggerBehavior RoutedEvent="{x:Static InputElement.PointerReleasedEvent}"
                                                            RoutingStrategies="Tunnel">
                                    <InvokeCommandAction Command="{Binding FileReplacedCommand}"
                                                         PassEventArgsToCommand="True" />
                                </RoutedEventTriggerBehavior>
                            </BehaviorCollection>
                        </BehaviorCollectionTemplate>
                    </Setter>
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="{x:Type vm:DirectoryVM}" ItemsSource="{Binding Children}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Classes.opened="{Binding $parent[TreeViewItem].IsExpanded}" Size="18">
                                <LucideIcon.Styles>
                                    <Style Selector="LucideIcon">
                                        <Setter Property="Kind" Value="Folder" />
                                    </Style>
                                    <Style Selector="LucideIcon.opened">
                                        <Setter Property="Kind" Value="FolderOpen" />
                                    </Style>
                                </LucideIcon.Styles>
                            </LucideIcon>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>

                <DataTemplate DataType="{x:Type vm:LayerVM}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="CircuitBoard" Size="19" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="LightBlue"
                                Text="{Binding Header}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:BoardVM}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Layers" Size="18" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="LightBlue"
                                Text="{Binding Header}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:StylesFileVM}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="PencilSparkles" Size="18" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="LightBlue"
                                Text="{Binding Header}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <ContentControl
            Grid.Column="2"
            Grid.Row="0"
            Margin="0,-1,0,0"
            Content="{Binding RootNode}"
            IsVisible="{Binding RootNode, Converter={x:Static ObjectConverters.IsNotNull}}"/>

        <TreeView 
            ItemsSource="{Binding ProjectErrors}"
            Grid.Column="2"
            Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderColor60}"
            Background="{DynamicResource WindowBackgroundColor}">
            <TreeView.Styles>
                <FluentTheme/>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>

                <!-- Шаблон 1: Корневой узел (ФАЙЛ) -->
                <TreeDataTemplate DataType="vm:FileErrorGroupVM" ItemsSource="{Binding Errors}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📄" />
                        <TextBlock
                            Text="{Binding FileName}"
                            FontWeight="Bold" />
                        <TextBlock
                            Text="{Binding Errors.Count, StringFormat='({0})'}"
                            Foreground="Gray" />
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Шаблон 2: Дочерний узел (ОШИБКА) -->
                <DataTemplate DataType="models:EditorError">
                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left">
                        <TextBlock Text="❌ " Foreground="Red" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Message}"
                            Margin="4,0,12,0"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Foreground="Gray">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="[Строка {0}, столбец {1}]">
                                    <Binding Path="Line" />
                                    <Binding Path="Column" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

            </TreeView.DataTemplates>
        </TreeView>

        <GridSplitter
            x:Name="VerticalSplitter"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            Width="4"
            MinWidth="4"
            Classes="overlay-splitter" />

        <GridSplitter
            x:Name="HorizontalSplitter"
            Grid.Column="2"
            Grid.Row="0"
            VerticalAlignment="Bottom"
            Height="4"
            MinHeight="4"
            Classes="overlay-splitter" />

        <Canvas Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <Border
                Canvas.Left="{Binding FakeFileX}"
                Canvas.Top="{Binding FakeFileY}"
                IsHitTestVisible="False">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsFileReplacing" />
                        <Binding Path="IsTabReplacing" />
                    </MultiBinding>
                </Border.IsVisible>
                <Grid>
                    <TextBlock
                        Background="Yellow"
                        IsVisible="{Binding DraggedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Text="{Binding DraggedFile?.Header}" />
                    <TextBlock
                        Background="Yellow"
                        IsVisible="{Binding DraggedTab, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Text="{Binding DraggedTab?.Header}" />
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>